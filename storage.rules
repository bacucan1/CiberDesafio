rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función de comprobación de autenticación básica
    function autenticado() {
      return request.auth != null;
    }

    // El usuario solo puede manipular su propio espacio
    function esPropietario(userId) {
      return autenticado() && request.auth.uid == userId;
    }

    // Validar tipo de contenido: solo imágenes legítimas
    function esImagenValida() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 2 * 1024 * 1024; // Máximo 2 MB
    }

    // Avatares de usuario
    match /users/{userId}/avatar {
      allow read: if autenticado();
      allow write: if esPropietario(userId) && esImagenValida();
      allow delete: if esPropietario(userId);
    }

    // Bloqueo por defecto para cualquier otra ruta (Principio de menor privilegio)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

