rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function esDocente() {
      return autenticado() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'docente';
    }

    match /usuarios/{uid} {
      allow read, create, update: if autenticado() && request.auth.uid == uid;
      allow read: if esDocente() && resource.data.institucion == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.institucion;
    }
    match /escenarios/{id} { allow read: if autenticado(); allow write: if false; }
    match /decisiones/{id} {
      allow create: if autenticado() && request.resource.data.uid == request.auth.uid;
      allow read: if autenticado() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /resultados_agregados/{id} {
      allow read: if esDocente() && resource.data.institucion == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.institucion;
      allow write: if false;
    }
  }
}