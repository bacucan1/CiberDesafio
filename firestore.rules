rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function ruta(coleccion, id) {
      return /databases/$(database)/documents/$(coleccion)/$(id);
    }

    function perfilExiste(uid) {
      return exists(ruta('usuarios', uid));
    }

    function perfilActual() {
      return get(ruta('usuarios', request.auth.uid)).data;
    }

    function esDocente() {
      return autenticado()
        && perfilExiste(request.auth.uid)
        && perfilActual().rol == 'docente'
        && perfilActual().institucion is string
        && perfilActual().institucion.size() >= 3;
    }

    function esEstudiante() {
      return autenticado()
        && perfilExiste(request.auth.uid)
        && perfilActual().rol == 'estudiante';
    }

    function codigoDocenteValido(codigo, institucion) {
      return codigo is string
        && codigo.matches('^[A-Za-z0-9-]{8,90}$')
        && exists(ruta('codigos_invitacion', codigo))
        && get(ruta('codigos_invitacion', codigo)).data.activo == true
        && get(ruta('codigos_invitacion', codigo)).data.institucion == institucion
        && get(ruta('codigos_invitacion', codigo)).data.usos is int
        && get(ruta('codigos_invitacion', codigo)).data.maxUsos is int
        && get(ruta('codigos_invitacion', codigo)).data.maxUsos == 1
        && get(ruta('codigos_invitacion', codigo)).data.usos >= 0
        && get(ruta('codigos_invitacion', codigo)).data.usos < get(ruta('codigos_invitacion', codigo)).data.maxUsos
        && getAfter(ruta('codigos_invitacion', codigo)).data.usos
          == get(ruta('codigos_invitacion', codigo)).data.usos + 1;
    }

    function camposPerfilValidos(datos) {
      return datos.keys().hasOnly([
          'uid', 'nombre', 'rol', 'institucion', 'grado', 'grupo', 'grupoId',
          'codigoInvitacion', 'codigoVinculacion', 'modoPrueba', 'fechaActualizacion'
        ])
        && datos.keys().hasAll(['uid', 'nombre', 'rol', 'institucion'])
        && datos.uid is string
        && datos.nombre is string
        && datos.nombre.size() > 0
        && datos.nombre.size() <= 80
        && datos.rol in ['estudiante', 'docente']
        && datos.institucion is string
        && datos.institucion.size() <= 100
        && (!('grupo' in datos) || (datos.grupo is string && datos.grupo.size() <= 60))
        && (!('grupoId' in datos) || (datos.grupoId is string && datos.grupoId.matches('^[a-f0-9]{64}$')))
        && (!('grado' in datos) || datos.grado in [9, 10, 11])
        && (!('codigoInvitacion' in datos) || datos.codigoInvitacion is string)
        && (!('codigoVinculacion' in datos) || datos.codigoVinculacion is string)
        && (!('modoPrueba' in datos) || datos.modoPrueba is bool)
        && (!('fechaActualizacion' in datos) || datos.fechaActualizacion is string);
    }

    function perfilNuevoValido(uid) {
      let datos = request.resource.data;
      return camposPerfilValidos(datos)
        && datos.uid == uid
        && (
          (datos.rol == 'estudiante'
            && datos.institucion == ''
            && !('codigoInvitacion' in datos)
            && !('codigoVinculacion' in datos)
            && !('grupo' in datos)
            && !('grupoId' in datos)
            && !('grado' in datos)
            && !('modoPrueba' in datos))
          ||
          (datos.rol == 'docente'
            && !('grado' in datos)
            && !('grupo' in datos)
            && !('grupoId' in datos)
            && !('codigoVinculacion' in datos)
            && (
              (datos.get('modoPrueba', false) == true && !('codigoInvitacion' in datos))
              || (!('modoPrueba' in datos)
                && codigoDocenteValido(datos.get('codigoInvitacion', null), datos.institucion))
            ))
        );
    }

    function codigoGrupoValido(codigo) {
      return codigo is string && codigo.matches('^[A-F0-9]{12}$');
    }

    function vinculacionValida(uid) {
      let nuevo = request.resource.data;
      let codigo = nuevo.get('codigoVinculacion', null);
      let invitacionPath = ruta('codigos_vinculacion', codigo);
      let grupoPath = ruta('grupos', nuevo.get('grupoId', ''));
      return codigoGrupoValido(codigo)
        && nuevo.keys().hasAll(['institucion', 'grupo', 'grupoId', 'codigoVinculacion'])
        && exists(invitacionPath)
        && get(invitacionPath).data.estado == 'activo'
        && get(invitacionPath).data.venceEn > request.time
        && get(invitacionPath).data.usos < get(invitacionPath).data.maxUsos
        && getAfter(invitacionPath).data.usos == get(invitacionPath).data.usos + 1
        && get(invitacionPath).data.codigo == codigo
        && nuevo.institucion == get(invitacionPath).data.institucion
        && nuevo.grupo == get(invitacionPath).data.grupo
        && nuevo.grupoId == get(invitacionPath).data.grupoId
        && exists(grupoPath)
        && get(grupoPath).data.institucion == nuevo.institucion
        && get(grupoPath).data.grupo == nuevo.grupo
        && (('grado' in get(invitacionPath).data) == ('grado' in nuevo))
        && (!('grado' in nuevo) || nuevo.grado == get(invitacionPath).data.grado)
        && (('grado' in get(grupoPath).data) == ('grado' in nuevo))
        && (!('grado' in nuevo) || nuevo.grado == get(grupoPath).data.grado);
    }

    function actualizacionNombrePermitida() {
      let nuevo = request.resource.data;
      let actual = resource.data;
      return nuevo.diff(actual).affectedKeys().hasOnly(['nombre', 'fechaActualizacion'])
        && nuevo.uid == actual.uid
        && nuevo.rol == actual.rol
        && nuevo.institucion == actual.institucion
        && nuevo.get('codigoInvitacion', null) == actual.get('codigoInvitacion', null)
        && camposPerfilValidos(nuevo);
    }

    function vinculacionEstudiantePermitida(uid) {
      let nuevo = request.resource.data;
      let actual = resource.data;
      return actual.rol == 'estudiante'
        && actual.institucion == ''
        && nuevo.diff(actual).affectedKeys().hasOnly([
          'institucion', 'grupo', 'grupoId', 'grado', 'codigoVinculacion', 'fechaActualizacion'
        ])
        && nuevo.uid == actual.uid
        && nuevo.rol == actual.rol
        && camposPerfilValidos(nuevo)
        && vinculacionValida(uid);
    }

    function docenteDeInstitucion(institucion) {
      return esDocente() && perfilActual().institucion == institucion;
    }

    function resultadoCoincideConPerfil(id, datos) {
      let grupoPath = ruta('grupos', datos.get('grupoId', ''));
      return esEstudiante()
        && datos.keys().hasOnly([
          'grupoId', 'grupo', 'institucion', 'grado', 'eje', 'estudiantes',
          'totalAciertos', 'totalDecisiones', 'porcentajeAciertos', 'fechaCalculo'
        ])
        && datos.keys().hasAll([
          'grupoId', 'grupo', 'institucion', 'eje', 'estudiantes',
          'totalAciertos', 'totalDecisiones', 'porcentajeAciertos', 'fechaCalculo'
        ])
        && datos.grupoId == perfilActual().grupoId
        && id == datos.grupoId + '_' + datos.eje
        && datos.grupo == perfilActual().grupo
        && datos.institucion == perfilActual().institucion
        && (('grado' in datos) == ('grado' in perfilActual()))
        && (!('grado' in datos) || datos.grado == perfilActual().grado)
        && datos.eje in ['fraude', 'relación de riesgo', 'higiene']
        && datos.estudiantes is int
        && datos.estudiantes > 0
        && datos.totalAciertos is int
        && datos.totalDecisiones is int
        && datos.totalDecisiones > 0
        && datos.totalAciertos >= 0
        && datos.totalAciertos <= datos.totalDecisiones
        && datos.porcentajeAciertos is number
        && datos.fechaCalculo is string
        && exists(grupoPath)
        && get(grupoPath).data.institucion == datos.institucion
        && get(grupoPath).data.grupo == datos.grupo
        && (('grado' in datos) == ('grado' in get(grupoPath).data))
        && (!('grado' in datos) || datos.grado == get(grupoPath).data.grado);
    }

    function porcentajeValido(datos) {
      return datos.porcentajeAciertos >= (datos.totalAciertos * 100 / datos.totalDecisiones) - 0.5
        && datos.porcentajeAciertos <= (datos.totalAciertos * 100 / datos.totalDecisiones) + 0.5;
    }

    function participanteCoincideConResultado(id, uid) {
      let resultadoPath = ruta('resultados_agregados', id);
      let despues = getAfter(resultadoPath);
      return uid == request.auth.uid
        && existsAfter(resultadoPath)
        && resultadoCoincideConPerfil(id, despues.data)
        && despues.data.totalDecisiones == (exists(resultadoPath)
          ? get(resultadoPath).data.totalDecisiones + 1
          : 1);
    }

    function participanteActualizadoValido(id) {
      let participantePath = /databases/$(database)/documents/resultados_agregados/$(id)/participantes/$(request.auth.uid);
      let existeAntes = exists(participantePath);
      let anterior = get(participantePath).data;
      let despues = getAfter(participantePath).data;
      return despues.keys().hasOnly(['aciertos', 'decisiones'])
        && despues.decisiones == (existeAntes ? anterior.decisiones + 1 : 1)
        && despues.aciertos >= (existeAntes ? anterior.aciertos : 0)
        && despues.aciertos <= (existeAntes ? anterior.aciertos + 1 : 1)
        && despues.aciertos <= despues.decisiones
        && participanteCoincideConResultado(id, request.auth.uid);
    }

    function resultadoNuevoValido(id) {
      let datos = request.resource.data;
      return resultadoCoincideConPerfil(id, datos)
        && datos.estudiantes == 1
        && datos.totalDecisiones == 1
        && datos.totalAciertos in [0, 1]
        && porcentajeValido(datos)
        && datos.totalAciertos == getAfter(
          ruta('resultados_agregados', id) + /participantes/$(request.auth.uid)
        ).data.aciertos
        && participanteActualizadoValido(id);
    }

    function resultadoActualizadoValido(id) {
      let nuevo = request.resource.data;
      let anterior = resource.data;
      let participantePath = /databases/$(database)/documents/resultados_agregados/$(id)/participantes/$(request.auth.uid);
      let existeParticipante = exists(participantePath);
      let participanteAntes = get(participantePath).data;
      let participanteDespues = getAfter(participantePath).data;
      return resultadoCoincideConPerfil(id, nuevo)
        && nuevo.totalDecisiones == anterior.totalDecisiones + 1
        && nuevo.totalAciertos == anterior.totalAciertos
          + (participanteDespues.aciertos - (existeParticipante ? participanteAntes.aciertos : 0))
        && nuevo.estudiantes == anterior.estudiantes + (existeParticipante ? 0 : 1)
        && porcentajeValido(nuevo)
        && participanteActualizadoValido(id);
    }

    match /usuarios/{uid} {
      allow get: if autenticado() && request.auth.uid == uid;
      allow list: if false;
      allow create: if autenticado() && request.auth.uid == uid && perfilNuevoValido(uid);
      allow update: if autenticado()
        && request.auth.uid == uid
        && (actualizacionNombrePermitida() || vinculacionEstudiantePermitida(uid));
      allow delete: if false;
    }

    match /codigos_invitacion/{codigo} {
      allow get: if autenticado()
        && resource.data.activo == true
        && resource.data.usos is int
        && resource.data.maxUsos is int
        && resource.data.maxUsos == 1
        && resource.data.usos < resource.data.maxUsos;
      allow list, create, delete: if false;
      allow update: if autenticado()
        && resource.data.activo == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos'])
        && request.resource.data.usos == resource.data.usos + 1
        && resource.data.maxUsos == 1
        && resource.data.usos < resource.data.maxUsos
        && getAfter(ruta('usuarios', request.auth.uid)).data.rol == 'docente'
        && getAfter(ruta('usuarios', request.auth.uid)).data.codigoInvitacion == codigo
        && getAfter(ruta('usuarios', request.auth.uid)).data.institucion == resource.data.institucion;
    }

    match /codigos_vinculacion/{codigo} {
      allow get: if esEstudiante()
        && resource.data.codigo == codigo
        && resource.data.estado == 'activo'
        && resource.data.venceEn > request.time
        && resource.data.usos < resource.data.maxUsos;
      allow list: if esDocente() && resource.data.creadoPor == request.auth.uid;
      allow create: if esDocente()
        && request.resource.data.keys().hasOnly([
          'codigo', 'grupoId', 'grupo', 'institucion', 'grado', 'creadoPor',
          'estado', 'usos', 'maxUsos', 'venceEn', 'fechaCreacion'
        ])
        && request.resource.data.keys().hasAll([
          'codigo', 'grupoId', 'grupo', 'institucion', 'creadoPor',
          'estado', 'usos', 'maxUsos', 'venceEn', 'fechaCreacion'
        ])
        && request.resource.data.codigo == codigo
        && codigo.matches('^[A-F0-9]{12}$')
        && request.resource.data.grupoId is string
        && request.resource.data.grupoId.matches('^[a-f0-9]{64}$')
        && request.resource.data.grupo is string
        && request.resource.data.institucion == perfilActual().institucion
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.usos == 0
        && request.resource.data.maxUsos == 30
        && request.resource.data.venceEn is timestamp
        && request.resource.data.venceEn > request.time
        && request.resource.data.venceEn <= request.time + duration.value(14, 'd')
        && request.resource.data.fechaCreacion is timestamp
        && getAfter(ruta('grupos', request.resource.data.grupoId)).data.institucion == request.resource.data.institucion
        && getAfter(ruta('grupos', request.resource.data.grupoId)).data.grupo == request.resource.data.grupo
        && request.auth.uid in getAfter(ruta('grupos', request.resource.data.grupoId)).data.profesores
        && (('grado' in request.resource.data) == ('grado' in getAfter(ruta('grupos', request.resource.data.grupoId)).data))
        && (!('grado' in request.resource.data)
          || request.resource.data.grado == getAfter(ruta('grupos', request.resource.data.grupoId)).data.grado);
      allow update: if (
          esDocente()
          && resource.data.creadoPor == request.auth.uid
          && resource.data.estado == 'activo'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revocadoEn'])
          && request.resource.data.estado == 'revocado'
          && request.resource.data.revocadoEn is timestamp
        ) || (
          esEstudiante()
          && resource.data.estado == 'activo'
          && resource.data.venceEn > request.time
          && resource.data.usos < resource.data.maxUsos
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usos'])
          && request.resource.data.usos == resource.data.usos + 1
          && get(ruta('usuarios', request.auth.uid)).data.institucion == ''
          && getAfter(ruta('usuarios', request.auth.uid)).data.codigoVinculacion == codigo
          && getAfter(ruta('usuarios', request.auth.uid)).data.institucion == resource.data.institucion
          && getAfter(ruta('usuarios', request.auth.uid)).data.grupo == resource.data.grupo
          && getAfter(ruta('usuarios', request.auth.uid)).data.grupoId == resource.data.grupoId
        );
      allow delete: if false;
    }

    match /grupos/{id} {
      allow get: if (autenticado() && !exists(ruta('grupos', id)))
        || (esDocente() && resource.data.institucion == perfilActual().institucion);
      allow list: if esDocente()
        && request.auth.uid in resource.data.profesores
        && resource.data.institucion == perfilActual().institucion;
      allow create: if esDocente()
        && request.resource.data.keys().hasOnly([
          'institucion', 'grupo', 'grado', 'profesores', 'fechaActualizacion'
        ])
        && request.resource.data.keys().hasAll(['institucion', 'grupo', 'profesores', 'fechaActualizacion'])
        && request.resource.data.institucion == perfilActual().institucion
        && request.resource.data.grupo is string
        && request.resource.data.grupo.size() >= 2
        && request.resource.data.grupo.size() <= 60
        && request.resource.data.profesores == [request.auth.uid]
        && request.resource.data.fechaActualizacion is timestamp
        && (!('grado' in request.resource.data) || request.resource.data.grado in [9, 10, 11]);
      allow update: if esDocente()
        && resource.data.institucion == perfilActual().institucion
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profesores', 'fechaActualizacion'])
        && request.resource.data.profesores.hasAll(resource.data.profesores)
        && request.auth.uid in request.resource.data.profesores
        && request.resource.data.profesores.size() <= resource.data.profesores.size() + 1
        && request.resource.data.fechaActualizacion is timestamp;
      allow delete: if false;
    }

    match /resultados_agregados/{id} {
      allow get: if autenticado()
        && (!exists(ruta('resultados_agregados', id))
          || docenteDeInstitucion(resource.data.institucion)
          || resultadoCoincideConPerfil(id, resource.data));
      allow list: if esDocente() && resource.data.institucion == perfilActual().institucion;
      allow create: if resultadoNuevoValido(id);
      allow update: if resultadoActualizadoValido(id);
      allow delete: if false;

      match /participantes/{uid} {
        allow get: if autenticado() && request.auth.uid == uid;
        allow list: if false;
        allow create: if autenticado()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['aciertos', 'decisiones'])
          && request.resource.data.decisiones is int
          && request.resource.data.decisiones == 1
          && request.resource.data.aciertos is int
          && request.resource.data.aciertos >= 0
          && request.resource.data.aciertos in [0, 1]
          && participanteCoincideConResultado(id, uid);
        allow update: if autenticado()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['aciertos', 'decisiones'])
          && request.resource.data.decisiones is int
          && request.resource.data.decisiones == resource.data.decisiones + 1
          && request.resource.data.aciertos is int
          && request.resource.data.aciertos >= resource.data.aciertos
          && request.resource.data.aciertos <= resource.data.aciertos + 1
          && request.resource.data.aciertos <= request.resource.data.decisiones
          && participanteCoincideConResultado(id, uid);
        allow delete: if false;
      }
    }

    match /escenarios/{id} {
      allow read: if autenticado();
      allow write: if false;
    }

    match /decisiones/{id} {
      allow read, write: if false;
    }

    match /instituciones/{id} {
      allow read: if autenticado()
        && perfilExiste(request.auth.uid)
        && perfilActual().institucion == resource.data.nombre;
      allow write: if false;
    }

    match /solicitudes_docente/{uid} {
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
